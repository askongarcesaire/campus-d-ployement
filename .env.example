# ==============================================================================
# CampusHub Africa — Variables d'Environnement
# ==============================================================================

# Port d'écoute du serveur (par défaut 3000)
PORT=3000
NODE_ENV=development

# Clé secrète de signature des jetons JWT d'authentification
JWT_SECRET=votre_cle_secrete_jwt_robuste_changez_la_en_production

# Connexion PostgreSQL (Optionnel en développement : utilise le moteur PGlite intégré)
# Pour une base de données PostgreSQL de production :
# DATABASE_URL=postgresql://campushub_user:campushub_secure_pass_2026@localhost:5432/campushub_db?schema=public

# Compte administrateur initial par défaut
# E-mail : admin@campushub.africa
# Mot de passe : Admin@CampusHub2026!

# Clé API Google Gemini (optionnel pour fonctionnalités d'assistance)
GEMINI_API_KEY=
